SHIFT_REPO_URL=https://github.com/Nevtep/shift-desoc.git
SHIFT_REPO_FULL_NAME=Nevtep/shift-desoc

# GitHub fine-grained token of a DEDICATED machine user (not your own account),
# invited as a collaborator with Write access. Repository permissions: Contents RW,
# Pull requests RW, Metadata R. The agent's commits and PRs are attributed to
# that account, so you can be the required reviewer without bypassing the rules.
GITHUB_TOKEN=

# Linear personal API key. Used by Hermes' Linear MCP server
# (Authorization: Bearer) so the supervisor can read/update Linear
# non-interactively, without an OAuth browser login.
LINEAR_API_KEY=

# Hermes supervisor model provider (at least one).
# OPENROUTER_API_KEY is the simplest non-interactive option.
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Claude Code (the coding agent Hermes delegates to). Set ONE of:
#   ANTHROPIC_API_KEY        -> API billing
#   CLAUDE_CODE_OAUTH_TOKEN  -> Pro/Max subscription (`claude setup-token`)
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Spend cap per Claude Code invocation (implementation or audit).
SHIFT_CLAUDE_MAX_BUDGET_USD=20

# Dashboard basic auth (required: the dashboard refuses to start without it).
HERMES_DASHBOARD_USERNAME=shift
HERMES_DASHBOARD_PASSWORD=
# Optional: 32+ random bytes (hex) so dashboard sessions survive restarts.
HERMES_DASHBOARD_SESSION_SECRET=

# Escarlet MCP v3 (daily Shift content). URL ends in /mcp/v3.
ESCARLET_MCP_URL=
ESCARLET_MCP_TOKEN=
# Brand/site id in Escarlet; required if the token sees more than one brand.
ESCARLET_SITE=
SHIFT_CONTENT_CHANNELS=instagram
# Job policy: true lets the daily job publish without human review.
SHIFT_CONTENT_AUTOPUBLISH=false

# Telegram gateway (bot from @BotFather). ALLOWED_USERS: your numeric user ID
# (ask @userinfobot); HOME_CHANNEL: chat ID for cron reports (same ID for a DM).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=

HERMES_IMAGE_TAG=v2026.9.24
CLAUDE_CODE_VERSION=2.1.294
PNPM_VERSION=9.15.9
ENGRAM_VERSION=1.20.0
GENTLE_AI_VERSION=4.2.0
SHIFT_LOOP_MINUTES=30
SHIFT_MAX_OPEN_PRS=2
SHIFT_MAX_REMEDIATIONS=3
SHIFT_ALLOW_CONTRACT_ISSUES=false
TZ=America/Argentina/Cordoba
