FROM nousresearch/hermes-agent:latest

USER root

ARG CODEX_VERSION=0.135.0
ARG PNPM_VERSION=9.15.9
ARG ENGRAM_VERSION=1.20.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git git-lfs jq openssh-client ripgrep sqlite3 \
    build-essential pkg-config libssl-dev gh \
    && rm -rf /var/lib/apt/lists/*

# Hermes already includes Node, but pin the CLIs used by Shift.
RUN npm install -g \
    "@openai/codex@${CODEX_VERSION}" \
    "pnpm@${PNPM_VERSION}" \
    && codex --version \
    && pnpm --version

# Instala únicamente el binario Gentle AI.
# La configuración de agentes y componentes se realiza después, en bootstrap.
RUN curl -fsSL \
      https://raw.githubusercontent.com/Gentleman-Programming/gentle-ai/main/scripts/install.sh \
      | bash \
    && gentle-ai --version

# Engram se instala explícitamente como herramienta independiente.
RUN set -eux; \
    architecture="$(dpkg --print-architecture)"; \
    case "$architecture" in \
      arm64) asset_arch="arm64" ;; \
      amd64) asset_arch="amd64" ;; \
      *) echo "Unsupported architecture: $architecture" >&2; exit 1 ;; \
    esac; \
    curl -fsSL \
      "https://github.com/Gentleman-Programming/engram/releases/download/v${ENGRAM_VERSION}/engram_${ENGRAM_VERSION}_linux_${asset_arch}.tar.gz" \
      -o /var/tmp/engram.tar.gz; \
    mkdir -p /var/tmp/engram-install; \
    tar -xzf /var/tmp/engram.tar.gz -C /var/tmp/engram-install; \
    install -m 0755 /var/tmp/engram-install/engram /usr/local/bin/engram; \
    rm -rf /var/tmp/engram.tar.gz /var/tmp/engram-install; \
    engram version

COPY hermes-bootstrap /opt/shift-hermes/bootstrap
COPY scripts /opt/shift-hermes/scripts

RUN chmod +x /opt/shift-hermes/scripts/*.sh \
    && mkdir -p /workspace /opt/data \
    && chown -R hermes:hermes /workspace /opt/data /opt/shift-hermes

USER hermes
WORKDIR /workspace/shift

# Keep the official image entrypoint and s6 supervision.
